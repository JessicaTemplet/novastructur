# Postgres connection string (Neon or any standard Postgres works).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js v5 session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Encrypts per-user bring-your-own-LLM API keys at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_KEY_ENCRYPTION_SECRET=""

# Optional: grounds "AI draft description" in this project's own docs/issues
# via binsg (local semantic search over a mirrored text corpus — see
# ../binsg). Leave both blank to skip grounding entirely; drafting still
# works fine without it, just less project-aware.
#   BINSG_BIN="C:/Users/jessi/Projects/binsg/target/release/binsg.exe"
#     (or wherever cargo put it — check $CARGO_TARGET_DIR if that's set)
#   BINSG_MODEL_DIR="C:/Users/jessi/Projects/binsg/model"
BINSG_BIN=""
BINSG_MODEL_DIR=""

# GitHub integration (OAuth device flow — no public callback URL required):
#   1. https://github.com/settings/developers -> New OAuth App
#      (any placeholder homepage/callback URL is fine; device flow never
#      redirects to it)
#   2. Open the app's settings and enable "Device Flow" (off by default)
#   3. Copy the Client ID below (NOT the client secret — device flow never
#      uses one)
GITHUB_OAUTH_CLIENT_ID=""
# Encrypts each user's GitHub access token at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_TOKEN_ENCRYPTION_SECRET=""
# Optional. Defaults to "repo" (read/write, all private repos included —
# GitHub's classic OAuth scopes have no read-only option for private repos).
# If you only ever link PRs on public repos, set this to "public_repo"
# instead to shrink what a leaked token could reach.
GITHUB_OAUTH_SCOPE=""
